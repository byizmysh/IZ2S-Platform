{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "PICO_SDK_PATH": "$env{PICO_SDK_PATH}"
      }
    },
    {
      "name": "pico2",
      "inherits": "base",
      "binaryDir": "build-pico2",
      "cacheVariables": {
        "PICO_BOARD": "pico2",
        "CIV7_TARGET_NAME": "civ7-pico2"
      }
    },
    {
      "name": "pico1",
      "inherits": "base",
      "binaryDir": "build-pico1",
      "cacheVariables": {
        "PICO_BOARD": "pico",
        "CIV7_TARGET_NAME": "civ7-pico1"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "pico2",
      "configurePreset": "pico2"
    },
    {
      "name": "pico1",
      "configurePreset": "pico1"
    }
  ]
}