{
  "format": "izlauncher.module",
  "formatVersion": 1,
  "apiVersion": 1,
  "id": "iz-exchange-fs",
  "name": "File Exchange FS",
  "version": "0.1.0",
  "moduleVersion": "0.1.0",
  "author": "IZMYSH and upstream contributors",
  "platforms": [
    "linux-x64",
    "linux-arm64"
  ],
  "requires": {
    "platformApi": 1,
    "shell": "izlauncher",
    "consoleAbi": 1
  },
  "switch": {
    "entry": "switch/app.json",
    "abi": 1,
    "files": [
      "switch/app.comp.spv.deflate",
      "switch/app.frag.spv",
      "switch/app.frag.spv.deflate",
      "switch/app.vert.spv",
      "switch/app.json",
      "switch/app.comp.spv",
      "switch/app.vert.spv.deflate",
      "switch/assets/icon.png",
      "switch/assets/data.bin",
      "switch/assets/state.bin",
      "switch/shaders/abi.glsl",
      "switch/shaders/app.vert",
      "switch/shaders/exchange.glsl",
      "switch/shaders/draw.glsl",
      "switch/shaders/app.comp",
      "switch/shaders/hb.glsl",
      "switch/shaders/app.frag"
    ]
  },
  "server": {
    "entry": "server/entry.cjs",
    "runtime": "node",
    "implementations": {
      "runtime": "modules/iz-exchange-fs/server/runtime.cjs"
    }
  },
  "dependencies": [
    {
      "kind": "module",
      "id": "iz-exchange",
      "version": ">=1.1.1"
    }
  ],
  "settingsSchema": [],
  "license": "GPL-2.0-or-later"
}
