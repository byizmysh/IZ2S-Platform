+   if (segment->alias_lease.start) {
       util_vma_heap_free(&owner->va_heap, segment->alias_lease.start,
                          segment->length_B);
+      segment->alias_lease.start = 0;
    }
    if (segment->map.mapped &&
        nvkmd_nvgpu_native_map_unmap(&segment->map, owner->runtime,
diff --git a/src/nouveau/vulkan/nvkmd/nvgpu/nvkmd_nvgpu_native_device_owner.h b/src/nouveau/vulkan/nvkmd/nvgpu/nvkmd_nvgpu_native_device_owner.h
index b9d9975..ab2db2a 100644
--- a/src/nouveau/vulkan/nvkmd/nvgpu/nvkmd_nvgpu_native_device_owner.h
+++ b/src/nouveau/vulkan/nvkmd/nvgpu/nvkmd_nvgpu_native_device_owner.h
@@ -211,9 +211,10 @@ struct nvkmd_nvgpu_native_device_owner {
     * first kind returns to the pool with its last view's unmap; device
