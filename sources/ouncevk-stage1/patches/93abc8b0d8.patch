       if (chunk->stranded_va || chunk->backing.maps) {
          chunk->next = owner->stranded_chunks;
diff --git a/src/nouveau/vulkan/nvkmd/nvgpu/nvkmd_nvgpu_native_chunked.h b/src/nouveau/vulkan/nvkmd/nvgpu/nvkmd_nvgpu_native_chunked.h
