From 435dc71f796ed8c9b1664c6a84b50c187147eb57 Mon Sep 17 00:00:00 2001
From: kurumuz <kurumuz1@gmail.com>
Date: Sun, 15 Nov 2026 12:44:50 +0300
Subject: [PATCH] Wait out slow memory requests and resume failed releases

---
 .../nvkmd/nvgpu/nvkmd_nvgpu_native_backing.c  |  48 +++--
 .../nvkmd/nvgpu/nvkmd_nvgpu_native_backing.h  |  36 +++-
 .../nvkmd/nvgpu/nvkmd_nvgpu_native_chunked.c  | 142 ++++++++++---
 .../nvkmd/nvgpu/nvkmd_nvgpu_native_chunked.h  |  12 +-
 .../nvgpu/nvkmd_nvgpu_native_device_owner.c   | 160 +++++++++------
 .../nvgpu/nvkmd_nvgpu_native_device_owner.h   |  21 +-
 .../nvkmd/nvgpu/nvkmd_nvgpu_native_host_mem.c |  17 +-
 .../nvkmd/nvgpu/nvkmd_nvgpu_native_map.c      |  26 ++-
 .../nvkmd/nvgpu/nvkmd_nvgpu_native_map.h      |  16 +-
 .../nvkmd/nvgpu/nvkmd_nvgpu_native_mem.c      |   8 +-
 .../nvkmd/nvgpu/nvkmd_nvgpu_native_mem.h      |   2 +-
 .../nvkmd/nvgpu/nvkmd_nvgpu_native_pdev.c     | 193 ++++++++++--------
 12 files changed, 466 insertions(+), 215 deletions(-)

diff --git a/src/nouveau/vulkan/nvkmd/nvgpu/nvkmd_nvgpu_native_backing.c b/src/nouveau/vulkan/nvkmd/nvgpu/nvkmd_nvgpu_native_backing.c
index 1e0e77d9..9f8022b0 100644
--- a/src/nouveau/vulkan/nvkmd/nvgpu/nvkmd_nvgpu_native_backing.c
+++ b/src/nouveau/vulkan/nvkmd/nvgpu/nvkmd_nvgpu_native_backing.c
@@ -234,6 +234,7 @@ backing_register(struct nvkmd_nvgpu_native_backing *backing,
                             BACKING_PREPARE_BIT, BACKING_PREPARE_BIT);
    if (R_FAILED(rc))
       return fail(backing, NVKMD_NVGPU_BACKING_PREPARE, rc);
+   backing->prepared = true;
    record_span(cpu_base, length);
 
    rc = gsvGpuRegisterMemory(&runtime->gpu, cpu_base, length,
@@ -252,6 +253,9 @@ backing_register(struct nvkmd_nvgpu_native_backing *backing,
       }
       return fail(backing, NVKMD_NVGPU_BACKING_REGISTER, rc);
    }
+   /* The range is registered from here, also when a check below fails: the
+    * caller releases the backing. */
+   backing->registered = true;
 
    if (!query(cpu_base, &info))
       return NVKMD_NVGPU_BACKING_QUERY;
@@ -271,6 +275,7 @@ backing_register(struct nvkmd_nvgpu_native_backing *backing,
       if (R_FAILED(rc))
          return fail(backing, NVKMD_NVGPU_BACKING_SET_ATTRIBUTES, rc);
    }
+   backing->attribute_set = true;
    record_uncached(cpu_base);
    if (!query(cpu_base, &info))
       return NVKMD_NVGPU_BACKING_QUERY;
@@ -310,29 +315,48 @@ nvkmd_nvgpu_native_backing_release(
 {
    if (!backing || !runtime || !slot)
       return NVKMD_NVGPU_BACKING_ARGUMENT;
-   if (backing->self != backing || !backing->ready || backing->maps ||
+   if (!nvkmd_nvgpu_native_backing_held(backing) || backing->maps ||
        backing->generation != runtime->generation || !slot->ready)
       return NVKMD_NVGPU_BACKING_STATE;
 
+   /* No new map from here. Each step clears its flag when it succeeds, so
+    * a call after a failure continues with the step that failed. */
    backing->ready = false;
    void *const cpu = (void *)(uintptr_t)backing->cpu_base;
    Result rc;
-   if (backing->cpu_uncached) {
+
+   if (backing->attribute_set) {
       rc = svcSetMemoryAttribute(cpu, backing->length,
                                  BACKING_UNCACHED_ATTRIBUTE, 0);
       if (R_FAILED(rc))
          return fail(backing, NVKMD_NVGPU_BACKING_SET_ATTRIBUTES, rc);
+      backing->attribute_set = false;
    }
-   rc = gsvGpuUnregisterMemory(&runtime->gpu, backing->range_id, slot->index);
-   if (R_FAILED(rc))
-      return fail(backing, NVKMD_NVGPU_BACKING_UNREGISTER, rc);
-   rc = nvkmd_nvgpu_native_slot_wait(slot);
-   if (R_FAILED(rc))
-      return fail(backing, NVKMD_NVGPU_BACKING_WAIT, rc);
-   rc = svcUnknown80(cpu, backing->length, BACKING_PREPARE_BIT, 0);
-   if (R_FAILED(rc))
-      return fail(backing, NVKMD_NVGPU_BACKING_PREPARE, rc);
-   forget_span(backing->cpu_base);
+
+   if (backing->registered) {
+      if (backing->unregister_unknown)
+         return NVKMD_NVGPU_BACKING_WAIT;
+      rc = gsvGpuUnregisterMemory(&runtime->gpu, backing->range_id,
+                                  slot->index);
+      /* Refused: the range is still registered. */
+      if (R_FAILED(rc))
+         return fail(backing, NVKMD_NVGPU_BACKING_UNREGISTER, rc);
+      rc = nvkmd_nvgpu_native_slot_wait(slot);
+      if (R_FAILED(rc)) {
+         backing->unregister_unknown = true;
+         return fail(backing, NVKMD_NVGPU_BACKING_WAIT, rc);
+      }
+      backing->registered = false;
+   }
+
+   if (backing->prepared) {
+      rc = svcUnknown80(cpu, backing->length, BACKING_PREPARE_BIT, 0);
+      if (R_FAILED(rc))
+         return fail(backing, NVKMD_NVGPU_BACKING_PREPARE, rc);
+      backing->prepared = false;
+      forget_span(backing->cpu_base);
+   }
+
    memset(backing, 0, sizeof(*backing));
    return NVKMD_NVGPU_BACKING_OK;
 }
diff --git a/src/nouveau/vulkan/nvkmd/nvgpu/nvkmd_nvgpu_native_backing.h b/src/nouveau/vulkan/nvkmd/nvgpu/nvkmd_nvgpu_native_backing.h
index eb6f4949..1b9176a8 100644
--- a/src/nouveau/vulkan/nvkmd/nvgpu/nvkmd_nvgpu_native_backing.h
+++ b/src/nouveau/vulkan/nvkmd/nvgpu/nvkmd_nvgpu_native_backing.h
@@ -34,8 +34,31 @@ struct nvkmd_nvgpu_native_backing {
    /* Mode 1: the CPU span keeps its cached attribute (no attribute-8 walk).
     * CPU maps need explicit cache maintenance. */
    bool cpu_cached;
+   /* What a release still has to undo. Each is set when its step of the
+    * registration succeeds, also when a later step fails, and cleared when
+    * its step of the release succeeds:
+    * the SVC 0x80 prepare bit is set over the span; */
+   bool prepared;
+   /* the worker registered the range (range_id); */
+   bool registered;
+   /* the uncached CPU attribute is set over the span (mode 2). */
+   bool attribute_set;
+   /* The worker accepted the unregister request and its wait failed with
+    * an error: whether the range is still registered is unknown, and the
+    * request is not sent again. */
+   bool unregister_unknown;
 };
 
+/* True while a release has something to undo: from the first successful
+ * step of a registration until a release completes. A backing can be held
+ * without being ready, after a registration or a release that failed. */
+static inline bool
+nvkmd_nvgpu_native_backing_held(const struct nvkmd_nvgpu_native_backing *backing)
+{
+   return backing->self == backing &&
+          (backing->prepared || backing->registered || backing->attribute_set);
+}
+
 /* Registers a page-aligned heap span. When cpu_cached is false, this is
  * mode 2. The steps are a QueryMemory check, zeroing, SVC 0x80 (mask and
  * value 0x20) and worker raw 0x75. Then CPU attribute 8 (uncached) is set
@@ -67,10 +90,15 @@ enum nvkmd_nvgpu_native_backing_status nvkmd_nvgpu_native_backing_import(
  * read/write, no attributes and no IPC or device references. */
 bool nvkmd_nvgpu_native_backing_importable(const MemoryInfo *info);
 
-/* Releases a backing that has no live maps. For mode 2, it first restores
- * the CPU attribute (SVC 3, mask 8, value 0). It then sends worker raw 0x76
- * on the request slot and waits for its completion. Last, it clears SVC 0x80
- * (mask 0x20, value 0).
+/* Releases a held backing that has no live maps. For mode 2, it first
+ * restores the CPU attribute (SVC 3, mask 8, value 0). It then sends worker
+ * raw 0x76 on the request slot and waits for its completion. Last, it
+ * clears SVC 0x80 (mask 0x20, value 0).
+ *
+ * The backing is not ready afterwards. A step that fails leaves the steps
+ * before it done, and a later call continues with the failed step: a
+ * refused unregister request is sent again, and after a completed one only
+ * the SVC 0x80 clear is repeated.
  */
 enum nvkmd_nvgpu_native_backing_status nvkmd_nvgpu_native_backing_release(
    struct nvkmd_nvgpu_native_backing *backing,
diff --git a/src/nouveau/vulkan/nvkmd/nvgpu/nvkmd_nvgpu_native_chunked.c b/src/nouveau/vulkan/nvkmd/nvgpu/nvkmd_nvgpu_native_chunked.c
index f0b2d5b2..5227d2f0 100644
--- a/src/nouveau/vulkan/nvkmd/nvgpu/nvkmd_nvgpu_native_chunked.c
+++ b/src/nouveau/vulkan/nvkmd/nvgpu/nvkmd_nvgpu_native_chunked.c
@@ -45,8 +45,35 @@ native_chunks_init(struct nvkmd_nvgpu_native_device_owner *owner)
    }
 }
 
+/* Puts a chunk on the owner's list of chunks that are out of the pool. It
+ * stays registered, with its memory. chunk_va is where its own mapping may
+ * remain, or 0. */
+static void
+native_chunk_set_aside(struct nvkmd_nvgpu_native_device_owner *owner,
+                       struct nvkmd_nvgpu_native_chunk *chunk,
+                       uint64_t chunk_va)
+{
+   chunk->stranded_va = chunk_va;
+   chunk->next = owner->stranded_chunks;
+   owner->stranded_chunks = chunk;
+}
+
+/* Sets a chunk aside after a failure: a mapping of it may remain, or its
+ * registration or release failed. It is not reused, and device close tries
+ * it again. */
+static void
+native_chunk_strand(struct nvkmd_nvgpu_native_device_owner *owner,
+                    struct nvkmd_nvgpu_native_chunk *chunk, uint64_t chunk_va,
+                    const char *what, Result rc)
+{
+   owner->stats.chunk_failures++;
+   mesa_loge("native chunk: %s: 0x%x; the chunk is not reused", what, rc);
+   native_chunk_set_aside(owner, chunk, chunk_va);
+}
+
 /* A chunk from the pool, or a new registered chunk. Call with the owner
  * lock held. */
+
 static struct nvkmd_nvgpu_native_chunk *
 native_chunk_take(struct nvkmd_nvgpu_native_device_owner *owner)
 {
@@ -71,10 +98,18 @@ native_chunk_take(struct nvkmd_nvgpu_native_device_owner *owner)
    if (nvkmd_nvgpu_native_backing_prepare(&chunk->backing, owner->runtime,
                                           cpu, NVKMD_NVGPU_NATIVE_CHUNK_B,
                                           false) != NVKMD_NVGPU_BACKING_OK) {
-      /* The remote state is unknown: keep the memory, do not reuse it. */
-      mesa_loge("native chunk: registration failed: 0x%x",
-                chunk->backing.result);
-      owner->stats.chunk_failures++;
+      if (nvkmd_nvgpu_native_backing_held(&chunk->backing)) {
+         /* Part of the registration remains (a prepared span, a registered
+          * range): the chunk keeps it, and device close releases it. */
+         native_chunk_strand(owner, chunk, 0, "registration failed",
+                             chunk->backing.result);
+      } else {
+         mesa_loge("native chunk: registration failed: 0x%x",
+                   chunk->backing.result);
+         owner->stats.chunk_failures++;
+         free(chunk->allocation);
+         free(chunk);
+      }
       return NULL;
    }
    owner->stats.chunks_registered++;
@@ -82,7 +117,8 @@ native_chunk_take(struct nvkmd_nvgpu_native_device_owner *owner)
 }
 
 /* Unregisters a chunk and frees its memory. The caller has completed and
- * flushed every GPU use of it. */
+ * flushed every GPU use of it. Returns false, with the chunk stranded,
+ * when the release failed. */
 static bool
 native_chunk_release(struct nvkmd_nvgpu_native_device_owner *owner,
                      struct nvkmd_nvgpu_native_chunk *chunk)
@@ -90,7 +126,8 @@ native_chunk_release(struct nvkmd_nvgpu_native_device_owner *owner,
    if (nvkmd_nvgpu_native_backing_release(&chunk->backing, owner->runtime,
                                           &owner->slot) !=
        NVKMD_NVGPU_BACKING_OK) {
-      owner->stats.chunk_failures++;
+      native_chunk_strand(owner, chunk, 0, "release failed",
+                          chunk->backing.result);
       return false;
    }
    free(chunk->allocation);
@@ -108,20 +145,13 @@ native_chunk_give_back(struct nvkmd_nvgpu_native_device_owner *owner,
    owner->free_chunk_count++;
 }
 
-/* A chunk whose mapping may remain is not reused: it stays registered and
- * out of the pool, and its memory is not freed. */
-static void
-native_chunk_strand(struct nvkmd_nvgpu_native_device_owner *owner,
-                    const char *what, Result rc)
-{
-   owner->stats.chunk_failures++;
-   mesa_loge("native chunk: %s failed: 0x%x; the chunk is not reused", what,
-             rc);
-}
-
 /* Unmaps the chunk mapped at chunk_va and returns it to the pool. Returns
- * false when the mapping may remain: then the chunk is stranded and the
- * caller must not reuse the VA. */
+ * false when that mapping may remain: the caller must not reuse the VA.
+ *
+ * A chunk that a view still maps is set aside, though its VA is free: a
+ * program may free memory before the sparse resource that is bound to it.
+ * The chunk returns to the pool when its last view is unmapped
+ * (nvkmd_nvgpu_native_owner_reclaim_chunks). */
 static bool
 native_chunk_unmap_give_back(struct nvkmd_nvgpu_native_device_owner *owner,
                              struct nvkmd_nvgpu_native_chunk *chunk,
@@ -132,10 +162,13 @@ native_chunk_unmap_give_back(struct nvkmd_nvgpu_native_device_owner *owner,
                                       chunk_va, NVKMD_NVGPU_NATIVE_CHUNK_B,
                                       &owner->slot, &rc) !=
        NVKMD_NVGPU_NATIVE_MAP_OK) {
-      native_chunk_strand(owner, "unmap", rc);
+      native_chunk_strand(owner, chunk, chunk_va, "unmap failed", rc);
       return false;
    }
-   native_chunk_give_back(owner, chunk);
+   if (chunk->backing.maps)
+      native_chunk_set_aside(owner, chunk, 0);
+   else
+      native_chunk_give_back(owner, chunk);
    return true;
 }
 
@@ -185,7 +218,7 @@ native_chunk_pool_trim(struct nvkmd_nvgpu_native_device_owner *owner,
       owner->free_chunks = chunk->next;
       owner->free_chunk_count--;
       if (!native_chunk_release(owner, chunk))
-         break; /* keep the rest; the failed chunk is not reused */
+         break; /* keep the rest in the pool */
    }
 }
 
@@ -287,7 +320,8 @@ nvkmd_nvgpu_native_chunked_mem_create(
                va_reusable = false;
          } else if (status == NVKMD_NVGPU_NATIVE_MAP_WAIT) {
             /* Accepted, and the wait failed: it may be mapped. */
-            native_chunk_strand(owner, "map wait", rc);
+            native_chunk_strand(owner, chunk, chunk_va, "map wait failed",
+                                rc);
             va_reusable = false;
          } else {
             /* Refused: nothing was mapped. */
@@ -358,6 +392,59 @@ nvkmd_nvgpu_native_chunked_mem_parts(
    return count;
 }
 
+void
+nvkmd_nvgpu_native_owner_reclaim_chunks(
+   struct nvkmd_nvgpu_native_device_owner *owner)
+{
+   struct nvkmd_nvgpu_native_chunk *chunk = owner->stranded_chunks;
+   owner->stranded_chunks = NULL;
+   while (chunk) {
+      struct nvkmd_nvgpu_native_chunk *next = chunk->next;
+      /* A chunk that failed keeps its place: its own mapping may remain,
+       * or its backing is no longer ready. */
+      if (!chunk->stranded_va && !chunk->backing.maps &&
+          chunk->backing.ready) {
+         native_chunk_give_back(owner, chunk);
+      } else {
+         chunk->next = owner->stranded_chunks;
+         owner->stranded_chunks = chunk;
+      }
+      chunk = next;
+   }
+}
+
+/* Tries the set-aside chunks again: unmaps one whose own mapping may
+ * remain, and releases one that nothing maps. Returns false when a chunk
+ * stays on the list. */
+static bool
+native_chunks_release_stranded(struct nvkmd_nvgpu_native_device_owner *owner)
+{
+   struct nvkmd_nvgpu_native_chunk *chunk = owner->stranded_chunks;
+   owner->stranded_chunks = NULL;
+   bool all_released = true;
+   while (chunk) {
+      struct nvkmd_nvgpu_native_chunk *next = chunk->next;
+      Result rc = 0;
+      if (chunk->stranded_va &&
+          nvkmd_nvgpu_native_unmap_range(owner->runtime, &chunk->backing,
+                                         chunk->stranded_va,
+                                         NVKMD_NVGPU_NATIVE_CHUNK_B,
+                                         &owner->slot, &rc) ==
+             NVKMD_NVGPU_NATIVE_MAP_OK)
+         chunk->stranded_va = 0;
+      /* native_chunk_release strands the chunk again when it fails. */
+      if (chunk->stranded_va || chunk->backing.maps) {
+         chunk->next = owner->stranded_chunks;
+         owner->stranded_chunks = chunk;
+         all_released = false;
+      } else if (!native_chunk_release(owner, chunk)) {
+         all_released = false;
+      }
+      chunk = next;
+   }
+   return all_released;
+}
+
 bool
 nvkmd_nvgpu_native_owner_release_chunks(
    struct nvkmd_nvgpu_native_device_owner *owner)
@@ -367,13 +454,14 @@ nvkmd_nvgpu_native_owner_release_chunks(
    list_for_each_entry_safe(struct nvkmd_nvgpu_native_chunked_mem, mem,
                             &owner->chunked_mems, link)
       native_chunked_mem_retire(mem);
-   bool ok = true;
    while (owner->free_chunks) {
       struct nvkmd_nvgpu_native_chunk *chunk = owner->free_chunks;
       owner->free_chunks = chunk->next;
       owner->free_chunk_count--;
-      if (!native_chunk_release(owner, chunk))
-         ok = false;
+      /* A failed release strands the chunk. */
+      native_chunk_release(owner, chunk);
    }
-   return ok;
+   /* Try every stranded chunk once more, those of the pool included. The
+    * result is whether any chunk remains. */
+   return native_chunks_release_stranded(owner);
 }
diff --git a/src/nouveau/vulkan/nvkmd/nvgpu/nvkmd_nvgpu_native_chunked.h b/src/nouveau/vulkan/nvkmd/nvgpu/nvkmd_nvgpu_native_chunked.h
