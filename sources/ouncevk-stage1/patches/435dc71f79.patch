 /* Releases every empty segment (no live slice) after one finish flush.
@@ -565,7 +569,7 @@ native_owner_grow_failed(struct nvkmd_nvgpu_native_device_owner *owner,
             empty_B += segment->length_B;
          if (segment->release_pending)
