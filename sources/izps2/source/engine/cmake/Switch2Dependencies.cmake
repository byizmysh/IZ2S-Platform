# All dependencies are compiled for devkitA64 from the local source snapshot.
# Do not satisfy target dependencies with Linux headers or binary archives.
set(CMAKE_SKIP_INSTALL_RULES ON)
find_package(Git)
find_package(Threads REQUIRED)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(BUILD_TESTING OFF CACHE BOOL "" FORCE)
set(MEDIA "${CMAKE_SOURCE_DIR}/platforms/android/app/src/main/cpp/3rdparty")
set(ZLIB_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
add_subdirectory("${CMAKE_SOURCE_DIR}/../deps/zlib" deps/zlib EXCLUDE_FROM_ALL)
add_library(ZLIB::ZLIB ALIAS zlibstatic)
configure_file("${CMAKE_SOURCE_DIR}/../deps/zlib/zlib.h" "${CMAKE_BINARY_DIR}/deps/zlib/zlib.h" COPYONLY)
set(ZLIB_LIBRARY zlibstatic CACHE STRING "" FORCE)
set(ZLIB_INCLUDE_DIR "${CMAKE_BINARY_DIR}/deps/zlib" CACHE PATH "" FORCE)
set(ZLIB_INCLUDE_DIRS "${CMAKE_SOURCE_DIR}/../deps/zlib;${CMAKE_BINARY_DIR}/deps/zlib")
set(ZLIB_FOUND TRUE)
set(ZSTD_BUILD_PROGRAMS OFF CACHE BOOL "" FORCE)
set(ZSTD_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(ZSTD_BUILD_SHARED OFF CACHE BOOL "" FORCE)
set(ZSTD_MULTITHREAD_SUPPORT OFF CACHE BOOL "" FORCE)
add_subdirectory("${MEDIA}/zstd/build/cmake" deps/zstd EXCLUDE_FROM_ALL)
add_library(Zstd::Zstd ALIAS libzstd_static)
add_library(lz4 STATIC "${MEDIA}/lz4/lib/lz4.c" "${MEDIA}/lz4/lib/lz4frame.c" "${MEDIA}/lz4/lib/lz4hc.c" "${MEDIA}/lz4/lib/xxhash.c")
target_include_directories(lz4 PUBLIC "${MEDIA}/lz4/lib")
add_library(LZ4::LZ4 ALIAS lz4)
set(PNG_SHARED OFF CACHE BOOL "" FORCE)
set(PNG_TESTS OFF CACHE BOOL "" FORCE)
set(PNG_TOOLS OFF CACHE BOOL "" FORCE)
set(PNG_EXECUTABLES OFF CACHE BOOL "" FORCE)
add_subdirectory("${MEDIA}/libpng" deps/png EXCLUDE_FROM_ALL)
add_library(PNG::PNG ALIAS png_static)
set(ENABLE_SHARED OFF CACHE BOOL "" FORCE)
set(ENABLE_STATIC ON CACHE BOOL "" FORCE)
set(WITH_SIMD OFF CACHE BOOL "" FORCE)
set(WITH_TURBOJPEG OFF CACHE BOOL "" FORCE)
add_subdirectory("${MEDIA}/libjpeg-turbo" deps/jpeg EXCLUDE_FROM_ALL)
target_include_directories(jpeg-static INTERFACE "${MEDIA}/libjpeg-turbo/src" "${CMAKE_BINARY_DIR}/deps/jpeg")
add_library(JPEG::JPEG ALIAS jpeg-static)
foreach(opt ANIM_UTILS CWEBP DWEBP GIF2WEBP IMG2WEBP VWEBP WEBPINFO EXTRAS WEBPMUX LIBWEBPMUX)
  set(WEBP_BUILD_${opt} OFF CACHE BOOL "" FORCE)
endforeach()
add_subdirectory("${MEDIA}/libwebp" deps/webp EXCLUDE_FROM_ALL)
add_library(WebP::libwebp ALIAS webp)
set(FT_DISABLE_BZIP2 ON CACHE BOOL "" FORCE)
set(FT_DISABLE_HARFBUZZ ON CACHE BOOL "" FORCE)
set(FT_DISABLE_BROTLI ON CACHE BOOL "" FORCE)
set(FT_DISABLE_PNG ON CACHE BOOL "" FORCE)
add_subdirectory("${MEDIA}/freetype" deps/freetype EXCLUDE_FROM_ALL)
add_library(Freetype::Freetype ALIAS freetype)
set(FREETYPE_FOUND TRUE)
set(FREETYPE_INCLUDE_DIRS "${MEDIA}/freetype/include")
set(FREETYPE_LIBRARIES freetype)
set(PLUTOSVG_ENABLE_FREETYPE OFF CACHE BOOL "" FORCE)
add_subdirectory(3rdparty/plutovg EXCLUDE_FROM_ALL)
target_compile_definitions(plutovg PRIVATE PLUTOVG_DISABLE_FONT_FACE_CACHE_LOAD)
add_subdirectory(3rdparty/plutosvg EXCLUDE_FROM_ALL)
# A compile-only CMake probe sees newlib declarations even for routines the
# platform does not provide. These optional host features have no libounce ABI.
foreach(feature HAVE_SIGNAL_H HAVE_SIGACTION HAVE_FDATASYNC HAVE_PTHREAD_SETNAME_NP HAVE_PTHREAD_SET_NAME_NP)
  set(${feature} 0 CACHE INTERNAL "Not available in libounce/newlib" FORCE)
endforeach()
foreach(dep fast_float libretro rapidyaml lzma libchdr soundtouch simpleini imgui cpuinfo libzip rcheevos rapidjson discord-rpc freesurround cubeb demangler ccc vixl fmt)
  add_subdirectory("3rdparty/${dep}" EXCLUDE_FROM_ALL)
endforeach()
if(USE_VULKAN)
  find_package(Shaderc REQUIRED)
  if(NOT SHADERC_LIBRARY MATCHES "(^|/)libshaderc_combined\\.a$")
    message(FATAL_ERROR "Switch 2 Vulkan needs the static libshaderc_combined.a. Build it with the shaderc target of the Switch Makefile.")
  endif()
  add_subdirectory(3rdparty/vulkan EXCLUDE_FROM_ALL)
endif()
target_compile_definitions(imgui PRIVATE IMGUI_DISABLE_DEFAULT_SHELL_FUNCTIONS)
add_compile_definitions(FMT_USE_EXCEPTIONS=0 FMT_USE_RTTI=0)
