/* name, result, parameters, arguments, unavailable result, launcher function */
#ifndef SB4_POSIX_VOID
#define SB4_POSIX_VOID(name, params, args) SB4_POSIX(name, void, params, args, (void)0, name)
#define SB4_POSIX_DEFAULT_VOID
#endif
#ifndef SB4_POSIX_MANAGED
#define SB4_POSIX_MANAGED SB4_POSIX
#define SB4_POSIX_DEFAULT_MANAGED
#endif
#ifndef SB4_POSIX_OPTIONAL
#define SB4_POSIX_OPTIONAL SB4_POSIX
#define SB4_POSIX_DEFAULT_OPTIONAL
#endif
