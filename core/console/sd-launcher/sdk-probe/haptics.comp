#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=1) in;
#include "state.glsl"
#include "hb.glsl"
void main(){
 c.game.x++;
 if(hbAvailable()&&!hbBusy()){
  if(c.game.y!=0u){c.game.z=hbResult();c.stats.z=hbResponseByte(0u);c.game.w++;c.game.y=0u;c.bagMeta.x=c.game.x+180u;}
  if(c.game.x>=c.bagMeta.x){
   hbHapticStep(0u,7u,vec4(.1,160.,.1,320.));hbHapticStep(1u,1u,vec4(.2,160.,.2,320.));hbHapticStep(2u,23u,vec4(.15,160.,.15,320.));
   if(hbPlayHaptics(2u,3u))c.game.y=1u;
  }
 }
 if((hbPressed()&HB_B)!=0u)hbExit();hbEndFrame();
}
