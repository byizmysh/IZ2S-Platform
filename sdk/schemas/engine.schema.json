{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "urn:izlauncher:engine:1",
  "title": "IZlauncher engine API 1",
  "required": [
    "format",
    "apiVersion",
    "id",
    "name",
    "version",
    "platforms",
    "entry",
    "modes"
  ],
  "properties": {
    "format": {
      "const": "izlauncher.engine"
    },
    "apiVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "platforms": {
      "type": "array",
      "items": {
        "enum": [
          "linux-x64",
          "linux-arm64",
          "win32-x64",
          "win32-arm64",
          "darwin-x64",
          "darwin-arm64"
        ]
      }
    },
    "modes": {
      "type": "array",
      "contains": {
        "const": "original"
      }
    },
    "bootstrap": {
      "type": "object",
      "required": [
        "file",
        "sha256",
        "installSlot",
        "saveName",
        "arity"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "installSlot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "saveName": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{1,16}$"
        },
        "arity": {
          "enum": [
            5,
            9
          ]
        }
      }
    },
    "installation": {
      "type": "object",
      "required": [
        "kind",
        "directory",
        "bootstrapPath",
        "requiredFiles"
      ],
      "properties": {
        "kind": {
          "const": "git"
        },
        "directory": {
          "const": "upstream"
        },
        "bootstrapPath": {
          "type": "string"
        },
        "requiredFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "runtimeEngine": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "directory": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,47}$"
    }
  }
}
