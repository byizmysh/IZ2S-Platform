{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "urn:izlauncher:module:1",
  "title": "IZlauncher module API 1",
  "required": [
    "format",
    "apiVersion",
    "id",
    "name",
    "version",
    "platforms",
    "formatVersion",
    "author",
    "requires"
  ],
  "properties": {
    "format": {
      "const": "izlauncher.module"
    },
    "apiVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "platforms": {
      "type": "array",
      "items": {
        "enum": [
          "linux-x64",
          "linux-arm64",
          "win32-x64",
          "win32-arm64",
          "darwin-x64",
          "darwin-arm64"
        ]
      }
    },
    "formatVersion": {
      "const": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "requires": {
      "type": "object",
      "required": [
        "platformApi"
      ],
      "properties": {
        "platformApi": {
          "const": 1
        }
      }
    },
    "switch": {
      "type": "object",
      "required": [
        "entry",
        "files",
        "abi"
      ],
      "properties": {
        "entry": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "abi": {
          "const": 1
        }
      }
    },
    "server": {
      "type": "object",
      "required": [
        "runtime",
        "entry"
      ],
      "properties": {
        "runtime": {
          "const": "node"
        },
        "entry": {
          "type": "string"
        },
        "sessionHook": {
          "type": "string"
        },
        "activation": {
          "type": "object",
          "required": [
            "offset",
            "sequenceOffset",
            "values"
          ],
          "properties": {
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1020
            },
            "sequenceOffset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1020
            },
            "values": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1
            }
          }
        },
        "assets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "localPackages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "path",
              "entry",
              "installer"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
              },
              "path": {
                "type": "string"
              },
              "entry": {
                "type": "string"
              },
              "installer": {
                "type": "string"
              },
              "importSource": {
                "type": "boolean"
              },
              "requiredFiles": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^runtime/"
                  }
                }
              }
            }
          }
        },
        "systemDependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "command",
              "purpose",
              "optional"
            ],
            "properties": {
              "command": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_.+-]+$"
              },
              "purpose": {
                "type": "string"
              },
              "optional": {
                "type": "boolean"
              },
              "platforms": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "settings": {
          "type": "object",
          "required": [
            "entry"
          ],
          "properties": {
            "entry": {
              "type": "string",
              "pattern": "^server/[^\\\\]+$"
            },
            "label": {
              "type": "string",
              "maxLength": 48
            }
          }
        }
      }
    },
    "installationDirectory": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,63}$",
      "description": "Optional physical directory under modules/. The API id stays stable."
    }
  },
  "anyOf": [
    {
      "required": [
        "switch"
      ]
    },
    {
      "required": [
        "server"
      ]
    }
  ]
}
