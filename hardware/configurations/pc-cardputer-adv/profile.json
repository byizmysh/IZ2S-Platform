{
  "id": "pc-cardputer-adv",
  "name": "PC + Cardputer ADV",
  "executionHost": "pc",
  "inputAdapter": "cardputer-wifi",
  "description": "Server on this PC sends input plans over Wi-Fi; Cardputer ADV types them over USB.",
  "fields": [
    {
      "key": "consoleHost",
      "label": "Server IPv4 address (empty = automatic)",
      "type": "text",
      "default": ""
    },
    {
      "key": "consoleAddress",
      "label": "Switch LAN IPv4 address (optional)",
      "type": "text",
      "default": ""
    },
    {
      "key": "consoleWifiAddress",
      "label": "Switch Wi-Fi IPv4 address (optional)",
      "type": "text",
      "default": ""
    },
    {
      "key": "cardputerEndpoint",
      "label": "Cardputer Wi-Fi address",
      "type": "text",
      "default": "http://iz2s-adv.local",
      "description": "Enter the IP shown on ADV, for example 192.168.1.50. The automatic name iz2s-adv.local refers to the same device on your local network."
    },
    {
      "key": "cardputerToken",
      "label": "Pairing key",
      "type": "password",
      "default": "",
      "description": "Generated by Prepare SD card package; it stays on this PC and the Cardputer."
    },
    {
      "key": "cardputerCapsLock",
      "label": "Switch keyboard Caps Lock state",
      "type": "select",
      "default": "off",
      "description": "Match Caps Lock on Switch. If uppercase commands appear lowercase, change this setting. Source text and quoted strings keep their intended case.",
      "options": [
        {
          "value": "off",
          "label": "Off"
        },
        {
          "value": "on",
          "label": "On"
        }
      ]
    }
  ],
  "format": "izlauncher.profile",
  "apiVersion": 1,
  "version": "0.21.0",
  "entry": "entry.cjs",
  "platforms": [
    "linux-x64",
    "linux-arm64"
  ],
  "nodes": [
    {
      "id": "server",
      "device": "linux-host",
      "roles": [
        "server"
      ]
    },
    {
      "id": "input",
      "device": "cardputer-adv",
      "roles": [
        "input"
      ]
    },
    {
      "id": "console",
      "device": "switch2",
      "roles": [
        "console"
      ]
    }
  ],
  "links": [
    {
      "id": "input-network",
      "from": "server",
      "to": "input",
      "type": "wifi"
    },
    {
      "id": "control",
      "from": "input",
      "to": "console",
      "type": "usb-hid"
    },
    {
      "id": "stream",
      "from": "server",
      "to": "console",
      "type": "network"
    }
  ],
  "ui": {
    "combined": false,
    "checks": [
      {
        "id": "server",
        "label": "Server",
        "icon": "i-server"
      },
      {
        "id": "arm",
        "label": "Cardputer ADV · input",
        "icon": "i-arm"
      },
      {
        "id": "usb",
        "label": "USB → Switch 2",
        "icon": "i-usb"
      },
      {
        "id": "lan",
        "label": "Console",
        "icon": "i-switch"
      }
    ]
  },
  "order": 2,
  "selectable": true
}
