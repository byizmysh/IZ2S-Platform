  dispatch3(p+20u,run?uvec3(r.w[p+3u],r.w[p+4u],r.w[p+5u]):uvec3(0));
  dispatch3(p+24u,run&&r.w[p+6u]!=0u?uvec3(1):uvec3(0));dispatch3(p+28u,on?uvec3(1):uvec3(0));
  r.w[p+32u]=on?3u:0u;r.w[p+33u]=on?1u:0u;r.w[p+34u]=0u;r.w[p+35u]=0u;
  if(on){uint old=r.w[p+38u];r.w[p+38u]=old+delta;r.w[p+39u]+=r.w[p+38u]<old?1u:0u;r.w[p+41u]++;}
 }
}
