#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=1) in;
#include "layout.glsl"
layout(set=0,binding=5,std430) buffer Input {uint w[];} source;
uint izPadRead(uint i){return source.w[i];}
