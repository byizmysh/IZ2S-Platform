#include "../../../../sdk/include/pad-merge.glsl"
uint buttons(){
 uint b=source.w[2];const uint ext=0x7f0000u/4u;
 if(source.w[ext]==0x48425344u&&(source.w[ext+3u]&64u)!=0u)
  for(uint i=0u;i<5u;i++){uint p=ext+160u+i*16u;if((source.w[p+8u]&1u)!=0u)b|=source.w[p+2u];}
 return b;
}
void dispatch3(uint p,uvec3 groups){r.w[p]=groups.x;r.w[p+1u]=groups.y;r.w[p+2u]=groups.z;}
void main(){
 if(!residentValid())return;
 izNormalizePad();
 uint count=r.w[2],current=r.w[3];r.w[24]=0u;
 if(current>=count||r.w[row(current)]!=1u){current=0u;r.w[3]=0u;r.w[7]|=1u;r.w[11]=1u;}
 uint low=source.w[RCLK],high=source.w[RCLK+1u],freq=source.w[RCLK+2u];
 bool valid=freq==RHZ;uint delta=0u;
 if(valid&&r.w[22]!=0u){uint upper=high-r.w[21]-(low<r.w[20]?1u:0u);delta=low-r.w[20];
  // Large clock gaps remain observable by apps; backwards/oversized time is bounded.
  if(upper!=0u){delta=RHZ;r.w[7]|=4u;}
 }
 r.w[16]=low;r.w[17]=high;r.w[18]=freq;r.w[19]=delta;
 r.w[20]=low;r.w[21]=high;r.w[22]=valid?1u:0u;
 uint held=buttons(),pressed=held&~r.w[10];r.w[10]=held;r.w[9]+=uint(bitCount(pressed));
 bool minus=(pressed&2048u)!=0u,home=false;
 if(minus&&current!=0u){
  uint elapsed=low-r.w[13],upper=high-r.w[14]-(low<r.w[13]?1u:0u);
  home=valid&&r.w[12]!=0u&&upper==0u&&elapsed<=9375000u;
  r.w[12]=home?0u:1u;r.w[13]=low;r.w[14]=high;
 }
 uint request=r.w[5];r.w[5]=0u;
 if(home)request=1u; // Requests use slot+1; zero means no request.
 if(request!=0u){
  r.w[25]++;uint next=request-1u;
  if(next>=count||r.w[row(next)]!=1u){r.w[7]|=2u;r.w[26]++;next=0u;}
  if(next!=current){
   r.w[4]=current;current=next;r.w[3]=next;r.w[6]++;r.w[23]++;r.w[24]=1u;r.w[11]=1u;r.w[12]=0u;
   if(next!=0u){uint p=row(next);r.w[p+7u]=1u;r.w[p+38u]=0u;r.w[p+39u]=0u;r.w[p+40u]++;}
  }
 }
 if(r.w[11]!=0u&&held==0u&&source.w[34]==0u)r.w[11]=0u;
 r.w[8]++;
