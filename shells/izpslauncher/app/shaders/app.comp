void launchSelection(){uint count=min(c.library.x,15u);if(c.state.x>=count){c.piece.x=1;c.piece.y=0;return;}uint kind=c.atlas[524288u+c.state.x*32768u+25604u];
#ifdef IZ_CALC
 if(kind==2u&&c.atlas[CB+7u]==CMAGIC){calcOpen();return;}
#endif
#ifdef IZ_STREAM
 if(kind==9u&&c.atlas[CB+7u]==CMAGIC){streamOpen();streamCommand(6u);c.atlas[SB+41u]=0u;return;} if(kind==8u&&c.atlas[CB+7u]==CMAGIC){streamOpen();streamCommand(5u);c.atlas[SB+41u]=0u;return;}if(kind==6u&&c.atlas[CB+7u]==CMAGIC){streamOpen();streamCommand(4u);return;}if(kind==5u&&c.atlas[CB+7u]==CMAGIC){streamOpen();streamCommand(3u);return;}if(kind==4u&&c.atlas[CB+7u]==CMAGIC){streamOpen();streamCommand(2u);return;}if(kind==3u&&c.atlas[CB+7u]==CMAGIC){streamOpen();uint command=c.atlas[524288u+c.state.x*32768u+25607u];if(command>0u&&command<=255u)streamCommand(command);return;}
#endif
#ifdef IZ_CONTROLLERS
 if(kind==7u&&c.atlas[CB+7u]==CMAGIC){controllerHubOpen();return;}
#endif
 if(kind!=1u)c.transition.y=1.0;
}
void launcherStep(){
 uint pressed=hbPressed();c.motion.x+=FOCUS_DT;c.state.z++;
 if(loadProgressVisible()&&c.atlas[LOAD_PROGRESS+2u]>=6u){if(c.atlas[LOAD_PROGRESS+5u]>0u)c.atlas[LOAD_PROGRESS+5u]--;else c.atlas[LOAD_PROGRESS]=0u;}
 if(loadProgressBusy()){c.rows[1]=0u;c.rows[12]=0u;c.rows[13]=0u;c.transition=vec4(0);hbEndFrame();return;}
 if(c.atlas[TOAST]==0x495a4e31u){uint seq=c.atlas[TOAST+1u];if(seq!=c.atlas[TOAST+3u]){c.atlas[TOAST+3u]=seq;c.atlas[TOAST+4u]=floatBitsToUint(TOAST_SECONDS);}else c.atlas[TOAST+4u]=floatBitsToUint(max(0.0,uintBitsToFloat(c.atlas[TOAST+4u])-FOCUS_DT));}
#ifdef IZ_CALC
 if(c.atlas[CB+7u]==CMAGIC&&c.atlas[CB+1u]==1u){calcInput(pressed);return;}
#endif
#ifdef IZ_STREAM
 if(c.atlas[CB+7u]==CMAGIC){streamLatch();if(c.atlas[CB+1u]==2u){
#ifdef IZ_VACOOTUBE_MENU
if(vacooMenuActive()){vacooMenuInput(pressed);return;}
#endif
streamInput(pressed);return;}}
#endif
#ifdef IZ_CONTROLLERS
 if(c.atlas[CB+7u]==CMAGIC&&c.atlas[CB+1u]==3u){controllerHubInput(pressed);return;}
#endif
 if(menuRemovalInput(pressed))return;
 if(c.transition.y!=0.0){c.transition.x=min(1.0,c.transition.x+1.0/15.0);if(c.transition.x>=1.0)c.reserved.y=c.state.x+1u;hbEndFrame();return;}
 c.transition.x=max(0.0,c.transition.x-1.0/15.0);
 // Vertical browsing is menu-owned scratch; module controls remain unchanged.
 uint scrollSteps=psScrollSteps();c.rows[12]=min(c.rows[12],scrollSteps);
 if(c.rows[1]==0u){
  if((pressed&HB_DOWN)!=0u)c.rows[12]=min(scrollSteps,c.rows[12]+1u);
  if((pressed&HB_UP)!=0u)c.rows[12]=c.rows[12]>0u?c.rows[12]-1u:0u;
  c.rows[14]=c.rows[14]>0u?c.rows[14]-1u:0u;float vertical=hbStick(false).y;
  if(abs(vertical)>.6&&c.rows[14]==0u){c.rows[12]=vertical<0.0?min(scrollSteps,c.rows[12]+1u):(c.rows[12]>0u?c.rows[12]-1u:0u);c.rows[14]=14u;}
 }
 float scrollTarget=min(float(c.rows[12])*140.0,psScrollMax());float scroll=mix(clamp(uintBitsToFloat(c.rows[13]),0.0,psScrollMax()),scrollTarget,.18);if(abs(scroll-scrollTarget)<.1)scroll=scrollTarget;c.rows[13]=floatBitsToUint(scroll);
 bool wasSearch=c.rows[1]!=0u;
 if((pressed&HB_Y)!=0u&&!wasSearch)c.rows[1]=1u;
 if(wasSearch){focusSearchInput(pressed);focusRebuild(c.piece.x!=0);hbEndFrame();return;}
 if(c.rows[1]!=0u){hbEndFrame();return;}
 if((pressed&HB_X)!=0u&&c.bagMeta.y==0u)c.piece.x=c.piece.x==0?1:0;
 bool picker=c.piece.x!=0;
 if((pressed&(HB_L|HB_R))!=0u&&c.bagMeta.y==0u)c.rows[0]=(c.rows[0]+((pressed&HB_R)!=0u?1u:2u))%3u;
 focusRebuild(picker);uint installed=min(c.library.x,15u),realCount=focusCount(picker),count=picker?max(realCount,1u):realCount+1u;
 uint ordinal=focusOrdinal(picker?uint(max(0,c.piece.y)):c.state.x,picker);
 uint selected=picker?(ordinal<realCount?ordinal:0u):(c.state.x>=installed||ordinal>=realCount?0u:ordinal+1u);
 c.motion.w=max(0.0,c.motion.w-FOCUS_DT);int move=0;if((pressed&HB_LEFT)!=0u)move=-1;if((pressed&HB_RIGHT)!=0u)move=1;float stick=hbStick(false).x;if(abs(stick)>.55&&c.motion.w<=0.0){move=stick>0.0?1:-1;c.motion.w=.18;}
 if(move!=0&&c.bagMeta.y==0u)selected=uint((int(selected)+move+int(count))%int(count));
 bool open=(pressed&HB_A)!=0u,touch=hbTouchCount()>0u&&(c.touch[6]&2u)==0u;vec2 p=touch?hbTouch(0u)*1.5:vec2(c.flow.z,c.flow.w);
 if(touch&&c.library.w==0u){c.flow.z=p.x;c.flow.w=p.y;c.bag[7]=0u;}
 if(touch&&c.library.w!=0u&&abs(p.x-c.flow.z)>85.0&&abs(p.y-c.flow.w)<90.0&&c.bagMeta.y==0u){int direction=p.x<c.flow.z?1:-1;selected=uint((int(selected)+direction+int(count))%int(count));c.bag[7]=1u;c.flow.z=p.x;}
 // A vertical touch drag scrolls the lower content; the rail keeps horizontal swipes.
 if(touch&&c.library.w!=0u&&abs(p.y-c.flow.w)>65.0&&abs(p.x-c.flow.z)<90.0&&p.y>650.0){int step=p.y<c.flow.w?1:-1;c.rows[12]=uint(clamp(int(c.rows[12])+step,0,int(scrollSteps)));c.bag[7]=1u;c.flow.w=p.y;}
 bool tap=!touch&&c.library.w!=0u&&c.bag[7]==0u;
 if(tap&&c.bagMeta.y==0u){
  vec2 contentPoint=p+vec2(0,scroll);int collection=psCollectionAt(contentPoint);
  if(psCategoryAt(p)>=0){c.rows[0]=uint(psCategoryAt(p));focusRebuild(picker);realCount=focusCount(picker);count=picker?max(realCount,1u):realCount+1u;selected=0u;}
  else if(psSearchHit(p))c.rows[1]=1u;
  else if(psContentHit(p)&&psExchangeHit(contentPoint)){if(picker)c.piece.x=0;else open=true;selected=0u;}
  else if(psContentHit(p)&&collection>=0&&collection<int(realCount)){uint target=picker?uint(collection):uint(collection)+1u;if(selected==target)open=true;selected=target;}
  else if(!picker&&all(lessThanEqual(abs(p+vec2(0,scroll)-HERO_CENTER),PS_CARD_HALF))){if(selected==0u)open=true;selected=0u;}
  else if(focusHeroHit(p+vec2(0,scroll))){if(realCount==0u&&focusRawCount(picker)>0u)c.rows[1]=1u;else open=true;}
  else{int first=int(floor(c.flow.x));for(int i=-1;i<7;i++){int index=first+i;if(index<0||index>=int(realCount))continue;vec2 center=focusCardCenter(float(index));if(center.x<500.0||center.x>1870.0)continue;if(focusCardHit(p+vec2(0,scroll),float(index))){uint target=picker?uint(index):uint(index)+1u;if(selected==target)open=true;selected=target;}}}
 }
 c.library.w=touch?1u:0u;
 if((pressed&HB_B)!=0u&&c.bagMeta.y==0u)c.piece.x=0;
 if(picker){c.piece.y=int(realCount>0u?focusIndex(selected):0u);if(open&&realCount>0u&&c.bagMeta.y==0u){c.piece.z++;c.piece.w=c.piece.y+1;c.bagMeta.y=1u;}}
 else{c.state.x=selected==0u?installed:focusIndex(selected-1u);if(open)launchSelection();}
 float index=picker?float(selected):float(max(int(selected)-1,0)),target=clamp(index-2.0,0.0,max(float(realCount)-5.0,0.0));if(c.stats.y!=(picker?1u:0u)){c.flow.x=target;c.stats.y=picker?1u:0u;}else c.flow.x=mix(c.flow.x,target,.22);if(abs(c.flow.x-target)<.002)c.flow.x=target;
 c.rows[11]=picker?selected:(selected==0u?realCount:selected-1u);
 c.motion.y=float(c.state.x);c.motion.z=0;hbEndFrame();
}
void main(){izNormalizePad();bool run=rsBegin();if(run)launcherStep();c.state.z=rs(6u);rsEnd();}
